
class Solution {
public:
    vector<int> minInterval(vector<vector<int>>& intervals, vector<int>& queries) {
        int n = intervals.size(), m = queries.size();
        vector<int> ans(m);
        multiset<int> st;
        deque<pair<int,pair<int,int>>> inter;
        deque<pair<int,int>>quer;
        for (int i = 0; i < n; i++) {
            int len = intervals[i][1] - intervals[i][0] + 1;
            inter.push_back({intervals[i][0], {len, 0}});
            inter.push_back({intervals[i][1], {len, 1}});
        }
        for (int i = 0; i < m; i++) {
            quer.push_back({queries[i], i});
        }
        sort(quer.begin(), quer.end());
        sort(inter.begin(), inter.end());

        int pre = -1, preAns = -1;
        while (quer.size()) {
            vector<int> eq;
            while (inter.size() && inter.front().first <= quer.front().first) {
                if (inter.front().second.second == 0) {
                    st.insert(inter.front().second.first);
                } else {
                    if (inter.front().first == quer.front().first) {
                        eq.push_back(inter.front().second.first);
                    } else {
                        st.erase(st.find(inter.front().second.first));
                    }
                }
                inter.pop_front();
            }

            if (quer.front().first  == pre) {
                ans[quer.front().second] = preAns;
            } else {
                ans[quer.front().second] = st.size() ? *st.begin() : -1;
            }

            for (auto it: eq) {
                st.erase(st.find(it));
            }
            pre = quer.front().first;
            preAns = ans[quer.front().second];
            quer.pop_front();
        }
        return ans;
    }
};
