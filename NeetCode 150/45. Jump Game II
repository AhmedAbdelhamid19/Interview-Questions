class Solution {
public:
    int dp[10005];
    int jump(vector<int>& nums) {
        for(int i=0; i<10005; i++) dp[i] = 1e9;
        int ans = run(nums, 0);
        return ans == 1e9 ? -1 : ans;
    }
    int run(vector<int>&nums, int i) {
        if(i == nums.size() - 1) {
            return 0;
        }

        int &ret = dp[i];
        if(ret != 1e9) return ret;

        for(int jump=1; jump<=nums[i] && i + jump < nums.size(); jump++) {
            ret = min(ret, 1 + run(nums, i + jump));
        }

        return ret;
    }
};
